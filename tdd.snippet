      <Code Language="csharp" Delimiter="$" Kind="method decl">
        <![CDATA[[Theory]
[InlineData(/* TODO: data */)]
public void $Method$__$Condition$__Should$Expected$(/* TODO: parameters */)
{
    // Arrange

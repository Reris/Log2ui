<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="Themes.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <x:Double x:Key="ButtonSpacing">5</x:Double>
      <x:Double x:Key="FollowupSpacing">12</x:Double>
      <Thickness x:Key="ContentMargin">12</Thickness>
      <Thickness x:Key="FollowupMarginVertical">0,12,0,0</Thickness>
      <x:Double x:Key="ExpanderMinHeight">12</x:Double>
      <Thickness x:Key="ExpanderChevronMargin">20,0,0,0</Thickness>


      <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
    </ResourceDictionary>
  </Styles.Resources>

  <StyleInclude Source="Tabalonia/_Index.axaml" />

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
  </Style>

  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
  </Style>

  <Style Selector="Button.save">
    <Setter Property="Background" Value="{DynamicResource ButtonSaveBrush}" />
  </Style>
  <Style Selector="Button.save:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonSaveHoverBrush}" />
  </Style>

  <Style Selector="DropDownButton.thinButton">
    <Setter Property="MinHeight" Value="26.6" />
  </Style>

  <Style Selector="Button.blinkActive i|MaterialIcon">
    <Style.Animations>
      <Animation Duration="0:0:0.8" IterationCount="INFINITE" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1.0" />
        </KeyFrame>
        <KeyFrame Cue="25%">
          <Setter Property="Opacity" Value="0.9" />
        </KeyFrame>
        <KeyFrame Cue="75%">
          <Setter Property="Opacity" Value="0.5" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.4" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
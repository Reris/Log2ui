<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Log2ui.Ui.Controls">
    <Styles.Resources>
        <ResourceDictionary>
            <ControlTheme x:Key="{x:Type c:ContentThumb}" TargetType="c:ContentThumb">
                <Setter Property="Template">
                    <ControlTemplate>
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Right"
                                              Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              Margin="0,0,5,4" />
                            <Panel />
                        </DockPanel>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>

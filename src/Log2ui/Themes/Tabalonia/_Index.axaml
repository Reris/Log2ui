<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tabalonia.Controls;assembly=Tabalonia">

  <StyleInclude Source="TabaloniaTabsControl.axaml" />
  <StyleInclude Source="TabaloniaTabsControl.axaml" />

  <Styles.Resources>
    <ResourceDictionary>
      <x:Double x:Key="TabItemHeaderFontSize">11</x:Double>
      <x:Double x:Key="TabItemMinHeight">32</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="controls|DragTabItem Button">
    <Setter Property="Background" Value="{DynamicResource TabsTopBackgroundBrush}" />
  </Style>
</Styles>
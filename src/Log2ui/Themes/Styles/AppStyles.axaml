<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <StyleInclude Source="/Themes/Styles/Tabalonia.axaml" />
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
    </Style>
    <Style Selector="Button.active i|MaterialIcon">
        <Style.Animations>
            <Animation Duration="0:0:0.8" IterationCount="INFINITE" PlaybackDirection="Alternate">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
                <KeyFrame Cue="25%">
                    <Setter Property="Opacity" Value="0.9" />
                </KeyFrame>
                <KeyFrame Cue="75%">
                    <Setter Property="Opacity" Value="0.5" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.4" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>

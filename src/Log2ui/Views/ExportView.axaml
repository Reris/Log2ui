<local:View x:TypeArguments="local:ExportViewModel" xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:Log2ui.Views"
            xmlns:controls="clr-namespace:Avalonia.PropertyGrid.Controls;assembly=Avalonia.PropertyGrid"
            mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
            x:Class="Log2ui.Views.ExportView"
            x:DataType="local:ExportViewModel">
  <HeaderedContentControl Header="{Binding Path=Header}">
    <StackPanel Orientation="Vertical">
      <controls:PropertyGrid DataContext="{Binding Path=Settings}" IsHeaderVisible="False" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource FollowupMarginVertical}" Spacing="{StaticResource ButtonSpacing}">
        <Button Command="{Binding Path=ExportCommand}" Classes="save">Export</Button>
        <Button Command="{Binding Path=CancelCommand}">Cancel</Button>
      </StackPanel>
    </StackPanel>
  </HeaderedContentControl>
</local:View>
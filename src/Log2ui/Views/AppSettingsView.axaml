<local:View xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:Log2ui.Views"
            xmlns:pgc="clr-namespace:Avalonia.PropertyGrid.Controls;assembly=Avalonia.PropertyGrid"
            mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
            x:TypeArguments="local:AppSettingsViewModel"
            x:DataType="local:AppSettingsViewModel"
            x:Class="Log2ui.Views.AppSettingsView">
    <Grid ColumnDefinitions="*, 4, *">
        <HeaderedContentControl Grid.Column="0" Header="General" Margin="{StaticResource ContentMargin}">
            <pgc:PropertyGrid DataContext="{Binding AppSettings^}" CommandExecuted="PropertyGrid_OnCommandExecuted">
            </pgc:PropertyGrid>
        </HeaderedContentControl>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
        <HeaderedContentControl Grid.Column="2" Header="Logger Defaults" Margin="{StaticResource ContentMargin}">
            <pgc:PropertyGrid DataContext="{Binding AppSettings^.LoggerDefaults}" CommandExecuted="PropertyGrid_OnCommandExecuted">
            </pgc:PropertyGrid>
        </HeaderedContentControl>
    </Grid>
</local:View>

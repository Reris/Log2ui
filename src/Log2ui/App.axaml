<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Log2ui.App"
             xmlns:local="using:Log2ui"
             xmlns:tabalonia="clr-namespace:Tabalonia.Themes.Fluent;assembly=Tabalonia"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="{Binding RelativeSource={RelativeSource Self}, Path=Theme^}"
             ActualThemeVariantChanged="Application_SetCurrentTheme"
             x:CompileBindings="True">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Ui/Converters/_Index.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <avalonia:MaterialIconStyles />
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" RegionColor="#181a1d" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <tabalonia:FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="/Themes/_Index.axaml" />
  </Application.Styles>
</Application>